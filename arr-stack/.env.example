# ===== Fill these in, then run:  python3 setup.py =====
# Blank secrets (API keys, passwords) are generated by setup.py and written back here.

# --- Host ---
HOST_IP=192.168.1.10              # LAN IP of this machine (used for dashboard links)
LOCAL_SUBNET=192.168.1.0/24
TIMEZONE=America/New_York
PUID=1000                         # `id -u`
PGID=1000                         # `id -g`
UMASK=002
DOCKER_SUBNET=172.28.10.0/24
DATA_ROOT=/srv/arr/data           # media + downloads (ONE filesystem, so hardlinks work)
CONFIG_ROOT=/srv/arr/config       # app settings

# --- VPN (REQUIRED: torrent + usenet clients only run through it) ---
# Provider list/options: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=             # e.g. protonvpn, mullvad, nordvpn, private internet access
VPN_TYPE=wireguard                # wireguard | openvpn
WIREGUARD_PRIVATE_KEY=            # wireguard
WIREGUARD_ADDRESSES=              # wireguard, e.g. 10.2.0.2/32
VPN_USERNAME=                     # openvpn
VPN_PASSWORD=                     # openvpn
SERVER_COUNTRIES=

# --- Ports ---
QBIT_WEBUI_PORT=8200
SAB_WEBUI_PORT=8100

# --- Generated by setup.py when blank ---
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
QBIT_USERNAME=admin
QBIT_PASSWORD=
ADMIN_USER=admin                  # Jellyfin / Seerr admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# --- Media sources (optional, can also be added later in the UIs) ---
# Prowlarr indexer definitions to add, comma separated (names as shown in Prowlarr's Add Indexer list)
INDEXERS=
# Usenet provider for SABnzbd
USENET_HOST=
USENET_PORT=563
USENET_USERNAME=
USENET_PASSWORD=
USENET_CONNECTIONS=20
